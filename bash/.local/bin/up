#!/usr/bin/env bash

set -e
set -o pipefail

AUTO_YES=0

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/up"
LOG="$STATE_DIR/last.log"

# Print a recap with diff-style coloring: removal ("- ") lines red, addition
# ("+ ") lines green. A "- " line directly followed by a "+ " line is a
# before/after pair (changed() guarantees it: pairs are adjacent, diff
# groups are separated by blank lines); for pairs the unchanged prefix and
# suffix keep the line color while the changed middle is bolded, like a git
# word diff. Display-only — stored recaps stay plain text, and color is
# skipped when stdout is not a tty or NO_COLOR is set.
show_recap() {
	if [[ ! -t 1 || -n ${NO_COLOR:-} ]]; then
		cat "$1"
		return
	fi
	awk '
		BEGIN {
			red = "\033[31m"; green = "\033[32m"
			bold = "\033[1m"; unbold = "\033[22m"; reset = "\033[0m"
		}
		function flush_pending() {
			if (pkind == "-")
				print red pline reset
			else if (pkind == "+")
				print green pline reset
			else if (pkind != "")
				print pline
			pkind = ""
		}
		function emit_pair(oline, nline,    op, np, ol, nl, p, s) {
			op = substr(oline, 5); np = substr(nline, 5) # strip "  - " / "  + "
			ol = length(op); nl = length(np)
			p = 0
			while (p < ol && p < nl && substr(op, p + 1, 1) == substr(np, p + 1, 1))
				p++
			s = 0
			while (s < ol - p && s < nl - p && substr(op, ol - s, 1) == substr(np, nl - s, 1))
				s++
			print red "  - " substr(op, 1, p) bold substr(op, p + 1, ol - p - s) unbold substr(op, ol - s + 1) reset
			print green "  + " substr(np, 1, p) bold substr(np, p + 1, nl - p - s) unbold substr(np, nl - s + 1) reset
		}
		/^  - / { flush_pending(); pline = $0; pkind = "-"; next }
		/^  \+ / {
			if (pkind == "-") {
				emit_pair(pline, $0)
				pkind = ""
			} else {
				flush_pending()
				print green $0 reset
			}
			next
		}
		{ flush_pending(); print }
		END { flush_pending() }
	' "$1"
}

# Parse flags
for arg in "$@"; do
	case "$arg" in
	-y | --yes) AUTO_YES=1 ;;
	-r | --recap)
		if [[ -s "$STATE_DIR/recap.txt" ]]; then
			show_recap "$STATE_DIR/recap.txt"
			exit 0
		fi
		printf "No recap from a previous run.\n" >&2
		exit 1
		;;
	-h | --help)
		printf "Usage: %s [--yes|-y] [--recap|-r]\n" "$(basename "$0")"
		printf "  -y, --yes    Run all steps without prompting\n"
		printf "  -r, --recap  Show the recap of the last run and exit\n"
		exit 0
		;;
	*)
		printf "Unknown option: %s\n" "$arg" >&2
		exit 1
		;;
	esac
done

# One instance at a time: two concurrent runs would interleave into the
# same log and recap.
mkdir -p "$STATE_DIR"
exec 9>"$STATE_DIR/lock"
if command -v flock >/dev/null 2>&1 && ! flock -n 9; then
	printf "another 'up' run appears to be in progress\n" >&2
	exit 1
fi

ask() {
	if ((AUTO_YES)); then
		return 0
	fi
	local prompt="$1"
	local reply
	printf '\n'
	read -rp "$prompt [Y/n] " reply
	[[ -z "$reply" || "$reply" =~ ^[Yy]$ ]]
}

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

: >"$LOG"

RECAP="$TMP/recap"
FAILURES="$TMP/failures"
printf "up %s\n" "$(date '+%Y-%m-%d %H:%M:%S')" >"$RECAP"
: >"$FAILURES"

# Announce a command, run it, and log its output. A failure does not abort
# the run; it is recorded in $FAILURES and reported in the recap. `-k N`
# treats exit code N as success (fwupdmgr exits 2 for "nothing to do").
run() {
	local ok=""
	while [[ $1 == -k ]]; do
		ok+=",$2"
		shift 2
	done
	printf '\n[%s]\n' "$*" | tee -a "$LOG"
	local status=0
	"$@" 2>&1 | tee -a "$LOG" || status=$?
	if ((status)) && [[ ,$ok, != *",$status,"* ]]; then
		printf '[exit %s]\n' "$status" | tee -a "$LOG"
		printf '%s (exit %s)\n' "$*" "$status" >>"$FAILURES"
	fi
	return 0
}

# Capture a tool's state listing to $TMP/$key for later diffing.
snap() {
	local key="$1"
	shift
	"$@" >"$TMP/$key" 2>/dev/null || : >"$TMP/$key"
}

# Append a recap entry for NAME: changed lines between the .before/.after
# snapshots, each "after" line under the "before" it replaced, or
# "(no changes)". Optional third arg adds a trailing note.
# diff -U 0 because BSD diff lacks GNU's --*-group-format; with no context
# each hunk is one group. Pairing is per group, and groups are blank-line
# separated, so a "- " directly above a "+ " is always a pair (show_recap
# relies on this).
changed() {
	local name="$1" key="$2" note="${3:-}" out
	out=$(
		diff -U 0 "$TMP/$key.before" "$TMP/$key.after" |
			awk '
				BEGIN { h = 1; q = 0 }
				function flush(    i) {
					for (i = h; i <= q; i++)
						print pend[i]
					h = 1
					q = 0
				}
				/^@@/ { flush(); print ""; hunk = 1; next }
				!hunk { next } # the ---/+++ file headers
				/^-/ { pend[++q] = "  - " substr($0, 2); next }
				/^\+/ {
					if (h <= q)
						print pend[h++]
					print "  + " substr($0, 2)
					next
				}
				END { flush() }
			' || true
	)
	{
		printf '\n%s:\n' "$name"
		if [[ -n "$out" ]]; then
			printf '%s\n' "$out"
		else
			printf '  (no changes)\n'
		fi
		if [[ -n "$note" ]]; then
			printf '%s\n' "$note"
		fi
	} >>"$RECAP"
}

# Record a step that was offered but declined.
skip() {
	printf '\n%s: (skipped)\n' "$1" >>"$RECAP"
}

# Format seconds elapsed since T0 (a $SECONDS snapshot) as "4m07s".
took() {
	local d=$((SECONDS - $1))
	printf '%dm%02ds' $((d / 60)) $((d % 60))
}

# Clean the log (strip progress-bar noise: \r and ANSI escapes), append
# failures, and persist the recap to the state dir. Runs on normal
# completion and on interrupt, so Ctrl-C keeps a partial recap.
# Not sed -i: BSD sed takes the next argument as a backup suffix.
save_recap() {
	local esc=$'\033'
	sed -e 's/\r//g' -e "s/${esc}\[[0-9;?]*[a-zA-Z]//g" "$LOG" >"$TMP/log.clean" && mv "$TMP/log.clean" "$LOG"
	if [[ -s "$FAILURES" ]]; then
		printf '\nFAILED:\n' >>"$RECAP"
		cat "$FAILURES" >>"$RECAP"
	fi
	printf '\nfull log: %s\n' "$LOG" >>"$RECAP"
	cp "$RECAP" "$STATE_DIR/recap.txt"
}
trap 'save_recap; printf "\ninterrupted; partial recap saved to %s\n" "$STATE_DIR/recap.txt" >&2; exit 130' INT TERM

printf "===================\nUPGRADING PACKAGES:\n===================\n"

if command -v dnf >/dev/null 2>&1; then
	if ask "Run DNF upgrade?"; then
		printf "\n====\nDNF:\n====\n"
		t0=$SECONDS
		# -y in auto mode: dnf's "Is this ok" prompt reads stdin fine here,
		# but AUTO_YES promises no prompting.
		snap dnf.before bash -c 'rpm -qa --qf "%{NAME} %{EVR}\n" | sort'
		if ((AUTO_YES)); then
			run sudo dnf upgrade -y
		else
			run sudo dnf upgrade
		fi
		if ((AUTO_YES)); then
			run sudo dnf autoremove -y
		else
			run sudo dnf autoremove
		fi
		snap dnf.after bash -c 'rpm -qa --qf "%{NAME} %{EVR}\n" | sort'
		changed DNF dnf "  (took $(took "$t0"))"
	else
		skip DNF
	fi
fi

if command -v flatpak >/dev/null 2>&1; then
	if ask "Run Flatpak update?"; then
		printf "\n========\nFLATPAK:\n========\n"
		t0=$SECONDS
		# --app alone misses runtime updates (they live in --runtime), and
		# runtime versions live in the branch column, not version.
		snap flatpak.before flatpak list --app --runtime --columns=application,branch,version
		# --noninteractive is required: run() pipes stdout through tee, and
		# flatpak auto-answers "no" to any question when stdout is not a tty.
		run flatpak update --noninteractive
		# -y for the same reason: without it the cleanup silently does nothing.
		run flatpak uninstall --unused -y --noninteractive
		snap flatpak.after flatpak list --app --runtime --columns=application,branch,version
		changed FLATPAK flatpak "  (took $(took "$t0"))"
	else
		skip FLATPAK
	fi
fi

if command -v fwupdmgr >/dev/null 2>&1; then
	if ask "Check firmware updates (fwupdmgr)?"; then
		printf "\n=========\nFIRMWARE:\n=========\n"
		t0=$SECONDS
		run -k 2 fwupdmgr refresh
		# get-updates exits non-zero when nothing is pending, so snap()
		# leaves the file empty and -s is the "updates exist" test.
		snap fw.updates fwupdmgr get-updates
		if [[ -s "$TMP/fw.updates" ]]; then
			# --no-reboot-check: the reboot decision stays with the user.
			run fwupdmgr update -y --no-reboot-check
			printf '\nFIRMWARE:\n  (staged; applied after reboot; took %s)\n' "$(took "$t0")" >>"$RECAP"
		else
			printf '\nFIRMWARE:\n  (no updates; took %s)\n' "$(took "$t0")" >>"$RECAP"
		fi
	else
		skip FIRMWARE
	fi
fi

if command -v mise >/dev/null 2>&1; then
	if ask "Run mise updates?"; then
		printf "\n=====\nMISE:\n=====\n"
		t0=$SECONDS
		snap mise.before bash -c 'mise --version; mise ls --current'
		run mise self-update
		run mise up
		snap mise.after bash -c 'mise --version; mise ls --current'
		changed MISE mise "  (took $(took "$t0"))"
	else
		skip MISE
	fi
fi

if command -v uv >/dev/null 2>&1; then
	if ask "Run uv tool upgrade --all?"; then
		printf "\n===\nUV:\n===\n"
		t0=$SECONDS
		snap uv.before uv tool list
		run uv tool upgrade --all
		snap uv.after uv tool list
		changed UV uv "  (took $(took "$t0"))"
	else
		skip UV
	fi
fi

if command -v pipx >/dev/null 2>&1; then
	if ask "Run pipx upgrade-all?"; then
		printf "\n=====\nPIPX:\n=====\n"
		t0=$SECONDS
		snap pipx.before pipx list --short
		run pipx upgrade-all
		snap pipx.after pipx list --short
		changed PIPX pipx "  (took $(took "$t0"))"
	else
		skip PIPX
	fi
fi

if command -v rustup >/dev/null 2>&1; then
	if ask "Run rustup upgrade?"; then
		printf "\n=======\nRUSTUP:\n=======\n"
		t0=$SECONDS
		snap rustup.before bash -c 'rustup --version 2>/dev/null; rustc --version'
		run rustup upgrade
		snap rustup.after bash -c 'rustup --version 2>/dev/null; rustc --version'
		changed RUSTUP rustup "  (took $(took "$t0"))"
	else
		skip RUSTUP
	fi
fi

if command -v cargo >/dev/null 2>&1; then
	if ask "Run cargo updates?"; then
		printf "\n======\nCARGO:\n======\n"
		t0=$SECONDS
		# install-update comes from the cargo-update helper; build it on
		# first use.
		if ! command -v cargo-install-update >/dev/null 2>&1; then
			run cargo install cargo-update
		fi
		snap cargo.before cargo install --list
		run cargo install-update -a
		snap cargo.after cargo install --list
		changed CARGO cargo "  (took $(took "$t0"))"
	else
		skip CARGO
	fi
fi

if command -v npm >/dev/null 2>&1; then
	if ask "Run npm global updates?"; then
		printf "\n====\nNPM:\n====\n"
		t0=$SECONDS
		snap npm.before npm ls -g --depth=0
		run npm u -g
		snap npm.after npm ls -g --depth=0
		changed NPM npm "  (took $(took "$t0"))"
	else
		skip NPM
	fi
fi

if command -v opencode >/dev/null 2>&1; then
	if ask "Run opencode upgrade?"; then
		printf "\n=========\nOPENCODE:\n=========\n"
		t0=$SECONDS
		snap opencode.before opencode --version
		run opencode upgrade
		snap opencode.after opencode --version
		changed OPENCODE opencode "  (took $(took "$t0"))"
	else
		skip OPENCODE
	fi
fi

if command -v pi >/dev/null 2>&1; then
	if ask "Run pi updates?"; then
		printf "\n===\nPI:\n===\n"
		t0=$SECONDS
		snap pi.before pi --version
		run pi update --all
		snap pi.after pi --version
		changed PI pi "  (extensions: see log; took $(took "$t0"))"
	else
		skip PI
	fi
fi

if command -v tldr >/dev/null 2>&1; then
	if ask "Update tldr cache?"; then
		printf "\n====\nTLDR:\n====\n"
		t0=$SECONDS
		run tldr --update
		printf '\nTLDR:\n  (cache updated; took %s)\n' "$(took "$t0")" >>"$RECAP"
	else
		skip TLDR
	fi
fi

if command -v dnf >/dev/null 2>&1; then
	RESTART=no
	if ! dnf needs-restarting -r &>/dev/null; then
		RESTART=yes
	fi
	printf "\nNEEDS RESTARTING?...%s\n" "$RESTART"
	printf '\nNEEDS RESTARTING?...%s\n' "$RESTART" >>"$RECAP"
fi

save_recap

printf "\n========\nRECAP:\n========\n"
show_recap "$RECAP"

printf "\n\nDONE UPGRADING\n"
